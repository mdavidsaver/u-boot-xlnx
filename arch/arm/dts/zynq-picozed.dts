/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "Zynq PicoZed Board";
	compatible = "xlnx,zynq-picozed", "xlnx,zynq-7000";

	aliases {
		serial0 = &uart1;
		spi0 = &qspi;
		mmc0 = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0x40000000>;
	};
};

&uart1 {
	bootph-all;
	status = "okay";
};

&qspi {
	bootph-all;
	status = "okay";
};

&sdhci0 {
	bootph-all;
	status = "okay";
};

&i2c0 {
	bootph-all;
	status = "okay";
};

&i2c1 {
	bootph-all;
	status = "okay";

	eeprom: eeprom@50 {
		compatible = "microchip,25aa25e48";
		reg = <0x50>;
	};
};

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
};
